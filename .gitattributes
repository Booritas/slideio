# MRXS test fixtures are exact byte sequences written by
# auxfiles/mrxs-fixtures/generate.py: line endings are part of what they test
# (layout-variants uses CRLF on purpose), so git must never convert them.
src/tests/mrxs/data/** -text

# LIF test fixtures are exact byte sequences written by
# auxfiles/lif-fixtures/generate.py (UTF-16 XML, binary framing): git must never
# convert them.
src/tests/lif/data/** -text
