# jxrlib is 2010-era C that conan center has no binary for at every compiler
# version -- it ships gcc 11 and 13 only, and no Debug build for any of them --
# so it is usually compiled from source here. GCC 14 turned several long-standing
# C warnings into errors by default, and jxrlib's jxrtestlib trips two of them.
# Demote just those, for just this package: -Wno-error rather than -Wno- keeps
# the diagnostics visible. Nothing slideio links is affected -- the recipe
# packages jxrglue and jpegxr, and the code that fails to compile is the test
# library built alongside them.
#
# -Wreturn-mismatch only exists from gcc 14 on -- gcc 13 reports the same thing
# under -Wreturn-type -- and an unknown warning name in -Wno-error= is a hard
# error, unlike a bare -Wno-, so passing it to gcc 13 breaks cmake's compiler
# check before a line of jxrlib is compiled. Hence the version guard, and hence
# compiler.version being detected at the top of this profile rather than pinned:
# it has to name the compiler that will actually run.
[conf]
jxrlib/*:tools.build:cflags=["-Wno-error=incompatible-pointer-types", "-Wno-error=implicit-function-declaration", "-Wno-error=int-conversion", "-Wno-error=implicit-int"{% if gcc_version | int >= 14 %}, "-Wno-error=return-mismatch"{% endif %}]
